# Copy this file to secrets.properties (same directory) and fill in the real values.
# secrets.properties is git-ignored: never commit it, never paste it into an issue.
# Without it the app builds and runs, but skips the update check and the report upload.

# Where the APK and latest.json live; the app asks for <updateBase>/latest.json.
# No trailing slash.
updateBase=

# Where ReportUpload posts its daily report. Keep the trailing slash.
reportUrl=

# Must equal GROWQUIZ_REPORT_TOKEN on the receiver (see server/README.md).
reportToken=
